# Copie para .env e ajuste conforme necessário.
APP_AMBIENTE=desenvolvimento
FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=troque-esta-chave
# Caminho dos CSVs normalizados (padrão: <raiz>/dataset/normalizado)
# DATASET_DIR=/caminho/para/dataset/normalizado
REFERENCE_DATE=2026-10-23
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
CORS_ORIGINS=*
