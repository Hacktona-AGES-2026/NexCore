# Copie para .env e ajuste conforme necessário.
APP_AMBIENTE=desenvolvimento
FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=troque-esta-chave
# Caminho dos CSVs normalizados (padrão: <raiz>/backend/dataset/normalizado)
# DATASET_DIR=/caminho/para/dataset/normalizado
# CSVs de origem que o verificador oficial lê em /painel/impacto (padrão: <raiz>/backend/dataset)
# VERIFIER_DATASET_DIR=/caminho/para/dataset
REFERENCE_DATE=2026-10-23
AUTO_REFRESH_DATASET=true
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
CORS_ORIGINS=*
# Caminho do canal WebSocket (padrão: /ws). O front abre ws://host/ws.
WS_PATH=/ws

# Hospital que a API da regulação atende: /v1/hospitais/<id> e /v1/ws?hospital=<id>
HOSPITAL_ID=hsl

# Textos do Neco escritos por IA (Gemini, plano gratuito). Crie a chave no Google AI Studio.
# Sem chave, o Neco usa os textos por regras. Confira no AI Studio o modelo e os limites atuais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
NECO_IA_ENABLED=true
# Requisições por minuto que o backend se permite fazer (abaixo do limite do plano gratuito)
NECO_IA_RPM=10
